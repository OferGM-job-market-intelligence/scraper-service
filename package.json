{
  "name": "scraper-service",
  "version": "1.0.0",
  "description": "Job scraping microservice - Fetches jobs from multiple sources",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "lint": "eslint src/**/*.ts",
    "build": "bun build src/index.ts --outdir dist",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "eslint": "^10.0.0",
    "ioredis": "^5.9.3",
    "kafkajs": "^2.2.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^25.2.3",
    "bun-types": "^1.3.9",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.55.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "module": "index.ts",
  "private": true,
  "peerDependencies": {
    "typescript": "^5"
  }
}
