{
  "name": "scraper-service",
  "version": "1.0.0",
  "description": "Job scraping microservice - Fetches jobs from multiple sources",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "lint": "eslint src/**/*.ts",
    "build": "bun build src/index.ts --outdir dist",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "latest",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.55.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
